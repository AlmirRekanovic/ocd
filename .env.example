# Secret used to sign session cookies (JWT). Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Initial admin (trainer) account, created automatically on first run.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Default country calling code used to build WhatsApp links from local numbers.
# Bosnia and Herzegovina = 387
DEFAULT_COUNTRY_CODE=387

# --- Database ---
# Production: hosted Turso (libSQL) database. Set BOTH of these on the host
# (e.g. Vercel). When TURSO_DATABASE_URL is present it is used automatically.
#   TURSO_DATABASE_URL=libsql://your-db-name.turso.io
#   TURSO_AUTH_TOKEN=your-turso-auth-token
#
# Local development: if TURSO_DATABASE_URL is NOT set, the app uses a plain
# SQLite file at ./data/ocd.db (no setup needed). Override the path if you want:
# DATABASE_PATH=./data/ocd.db

# --- Automatic WhatsApp membership reminders (WhatsApp Business Cloud API) ---
# Reminders go out daily (vercel.json cron): 3 days before expiry and on the
# expiry day. Until all four WHATSAPP_* values below are set, nothing is sent.
# WHATSAPP_ACCESS_TOKEN=permanent-system-user-token
# WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Approved template names. Both templates use {{1}} = member name,
# {{2}} = expiry date (e.g. 15.10.2026.).
# WHATSAPP_TEMPLATE_BEFORE=clanarina_istice_uskoro
# WHATSAPP_TEMPLATE_DUE=clanarina_istice_danas
# Must match the language selected for the templates in Meta.
# WHATSAPP_TEMPLATE_LANG=hr
# WHATSAPP_GRAPH_VERSION=v23.0
#
# Protects /api/cron/reminders. Vercel Cron sends it automatically when set.
# CRON_SECRET=another-long-random-string
